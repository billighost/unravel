# -----------------------------------------------------------------------------
# UNRAVEL - BACKEND ENVIRONMENT VARIABLES CONFIGURATION
# -----------------------------------------------------------------------------
# Copy this file to '.env.local' and populate the values for local development.
# For Vercel deployments, add these variables in the Vercel project settings dashboard.
# IMPORTANT: Never commit real credentials to this file.

# 1. Database (Neon Postgres Serverless)
# Example: postgres://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=

# 2. Rate Limiting & Caching (Upstash Redis REST API)
# Get these from your Upstash console (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 3. Media Upload (Cloudinary)
# Get these from your Cloudinary dashboard (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
