# -----------------------------------------------------------------------------
# UNRAVEL - TEST ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------------
# Copy this file to '.env.test.local' and populate the values.
# This file is committed as a reference. The actual .env.test.local is gitignored.
#
# IMPORTANT: DATABASE_URL_TEST must point to an ISOLATED Neon branch,
# never to the production database.
#
# To create a Neon branch:
#   1. Go to your Neon console: https://console.neon.tech
#   2. Select your project → Branches → Create Branch
#   3. Name it "test" or "ci"
#   4. Copy the branch's connection string below

DATABASE_URL_TEST=

# Optional: Override the dev server URL for tests (default: http://localhost:3000)
TEST_BASE_URL=http://localhost:3000
